# App
# NODE_ENV is set automatically by Next.js (development | production | test). Do not set in .env.
# Canonical public URL (auth redirects, emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (client-safe). Dashboard: Settings > API Keys > Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy anon key fallback (optional). Used when publishable key is absent.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Postgres (Kysely)
# From Supabase: Project Settings > Database > Connection string (URI).
# Required to read Supabase Vault for the server secret key.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Public docs — show internal admin docs at /docs/admin (default: hidden)
SHOW_ADMIN_DOCS=true

# Marketing
NEXT_PUBLIC_SALES_EMAIL=hello@fynda.idea

# Server-only — admin media uploads to Supabase Storage (and optional for `npm run seed:admin`).
# Dashboard: Settings → API Keys → Secret key (or legacy service_role JWT).
# Same value you store in Vault as `supabase_secret_key`. Never commit; never expose to the browser.
# SUPABASE_SECRET_KEY=sb_secret_...

# Storage bucket (default: documents). Keep private — served via server secret key.
# SUPABASE_STORAGE_BUCKET=documents

# MCP OAuth — HMAC secret for authorize state + access/refresh tokens.
# Required for Claude-style OAuth connectors. Generate a long random string.
# MCP_OAUTH_SECRET=
